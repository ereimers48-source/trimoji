# Stripe test mode first. Use an sk_test_ secret and a test-mode webhook secret.
# Switch both to live values only when you are ready to charge real cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful private token. Store 18937301 is Trimoji.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=18937301

# Public origin of this Vercel deployment, no trailing slash.
# Example: https://trimoji.vercel.app
SITE_URL=

# Leave false (or unset) to create Printful draft orders. Set to true to submit them.
PRINTFUL_AUTO_CONFIRM=false

# Unset, or any value other than false, 0, no, or off, keeps the kiss-cut sticker sheet in the shop.
# Set false to hide it and reject new checkout lines. Paid orders still fulfill.
STICKER_SHEET_ENABLED=
